// fstab
prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab/fstab.qcom",
    vendor: true,
    ramdisk_available: true,
    vendor_ramdisk_available: true,
}

// Init configuration files
prebuilt_etc {
    name: "init.qcom.power.rc",
    src: "init/init.qcom.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.qcom.rc",
    src: "init/init.qcom.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "init/init.recovery.qcom.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "init/init.target.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.xiaomi.rc",
    src: "init/init.xiaomi.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.qcom.rc",
    filename: "ueventd.rc",
    src: "init/ueventd.qcom.rc",
    vendor: true,
}
